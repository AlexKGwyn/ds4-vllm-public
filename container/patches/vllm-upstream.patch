+    return _DS4_N_CU
+
+
+def _ds4_backend():
+    global _DS4_BACKEND
+    if _DS4_BACKEND is None:
+        _DS4_BACKEND = triton.runtime.driver.active.get_current_target().backend
+    return _DS4_BACKEND

+			u32 len = tbv_zc_stream_chunk_len(stream,
+							  stream->posted);
+			struct tbv_zc_rx_desc *desc;
+			struct tbv_data_frame *bounce = NULL;
+			dma_addr_t dma = 0;
+			bool placed = false;
+
+			if (list_empty(&path->zc_free_descs))
+				goto out;
+			desc = list_first_entry(&path->zc_free_descs,
+						struct tbv_zc_rx_desc, node);
+
+			if (stream->mr_handle && !stream->error)
+				placed = !tbv_ibdev_zc_chunk_dma(
+					stream->mr_handle,
+					stream->hdr.remote_addr +
+					stream->posted, len, &dma);
+			if (!placed) {
+				if (list_empty(&path->zc_free_bounce))
+					goto out;
+				bounce = list_first_entry(
+					&path->zc_free_bounce,
+					struct tbv_data_frame, free_node);
+				dma_sync_single_for_device(
+					tb_ring_dma_device(path->rx_ring),
+					bounce->dma, TBV_DATA_FRAME_SIZE,
+					DMA_FROM_DEVICE);
+			}
+
+			desc->stream = stream;
+			desc->bounce = bounce;
+			desc->expect_len = len;
+			desc->frame.buffer_phy = bounce ? bounce->dma : dma;
+			desc->frame.callback = tbv_path_zc_rx_complete;
+			desc->frame.size = 0;
+			desc->frame.flags = 0;
+			desc->frame.sof = 0;
+			desc->frame.eof = 0;
+			if (tb_ring_rx(path->rx_ring, &desc->frame))
+				goto out;
+			list_del_init(&desc->node);
+			if (bounce)
+				list_del_init(&bounce->free_node);
+			stream->posted += len;
+			stream->outstanding++;
+			granted++;
+		}
+	}
+out:
+	spin_unlock_irqrestore(&path->zc_lock, flags);
+	if (granted)
+		tbv_path_zc_grant_credits(path, granted);
+}

+/*
+ * TX-worker frame fill for the copied RC/host-memory datapath. Produces the
+ * 48B native header followed by the gathered MR payload directly into the
+ * pre-mapped ring staging buffer @dst, eliminating both the per-fragment
+ * kmalloc'd frame and the stage memcpy. Invoked from the path TX worker (see
+ * tbv_path_owned_frame::fill). The owning send ctx is kept alive by the
+ * in-flight packet's reference and ctx->segs stay valid across retransmits, so
+ * a (re)fill always reads consistent, still-owned source memory. The bytes
+ * written are identical to the old two-copy path — the wire format and the
+ * receiver are unchanged.
+ */
+static int tbv_send_frame_fill(void *fill_ctx, void *dst, u32 dst_len,
+			       u32 frag_offset, bool last)
+{
+	struct tbv_send_ctx *ctx = fill_ctx;
+	struct tbv_native_data_header hdr;
+	u32 payload_len;
+	int ret;
+
+	if (dst_len < TBV_NATIVE_DATA_HDR_SIZE)
+		return -EINVAL;
+	payload_len = dst_len - TBV_NATIVE_DATA_HDR_SIZE;
+
+	tbv_send_ctx_build_native_header(ctx, frag_offset, payload_len, last,
+					 &hdr);
+	ret = tbv_native_data_build_header(dst, dst_len, &hdr);
+	if (ret < 0)
+		return ret;
+
+	ret = tbv_copy_send_range(ctx->segs, ctx->nsegs, frag_offset,
+				  (u8 *)dst + TBV_NATIVE_DATA_HDR_SIZE,
+				  payload_len);
+	if (ret)
+		atomic64_inc(&ctx->tqp->owner->data_wr_copy_error);
+	return ret;
+}
+
+/*

+static int tbv_send_split_hdr_prep(void *hdr_ctx, void *dst, u32 dst_len,
+				   u32 frag_offset, u32 chunk_len, bool last,
+				   tbv_path_tx_done_fn *done, void **done_ctx)
+{
+	struct tbv_send_page_stream *stream = hdr_ctx;
+	struct tbv_native_data_header hdr;
+	int ret;
+
+	if (dst_len < TBV_NATIVE_DATA_HDR_SIZE)
+		return -EINVAL;
+
+	tbv_send_ctx_build_native_header(stream->send, frag_offset, chunk_len,
+					 last, &hdr);
+	hdr.flags |= TBV_NATIVE_DATA_F_SPLIT_PAYLOAD;
+	ret = tbv_native_data_build_header(dst, dst_len, &hdr);
+	if (ret < 0)
+		return ret;
+
+	refcount_inc(&stream->refs);
+	atomic_inc(&stream->send->tx_pending);
+	tbv_send_ctx_get(stream->send);
+	*done = tbv_send_page_stream_done;
+	*done_ctx = stream;
+	return 0;
+}

+/*
+ * Route this raw WRITE stream's payload onto the rail's zero-copy path?
+ * Requires the zc gate open on the rail AND a source layout that yields the
+ * canonical chunk shape the receiver posts descriptors for
+ * ([first, 4K, 4K, ..., tail]): a single dma-buf SGE that is either one
+ * contiguous DMA run or 4K-aligned over 4K-granular sg entries.
+ */
+static bool tbv_send_ctx_zc_path_eligible(struct tbv_send_ctx *ctx,
+					  struct tbv_path *path)
+{
+	struct tbv_send_segment *seg;
+	struct tbv_rail *rail = path->rail;
+	dma_addr_t dma;
+	u32 run_len;
+
+	if (!rail || !tbv_rail_zc_tx_ready(rail))
+		return false;
+	if (ctx->nsegs != 1)
+		return false;
+	seg = &ctx->segs[0];
+	if (!seg->mr->dmabuf)
+		return false;
+	if (tbv_umem_dma_from_addr(seg->mr, seg->addr,
+				   min_t(u32, ctx->total_len, U32_MAX),
+				   &dma, &run_len))
+		return false;
+	if (run_len >= ctx->total_len)
+		return true;
+	if (seg->mr->zc_sg_4k &&
+	    !((ib_umem_offset(seg->mr->umem) +
+	       (seg->addr - seg->mr->start)) & (SZ_4K - 1)))
+		return true;
+	return false;
+}

+static void tbv_path_zc_rx_complete(struct tb_ring *ring,
+				    struct ring_frame *frame, bool canceled)
+{
+	struct tbv_zc_rx_desc *desc = container_of(frame,
+						   struct tbv_zc_rx_desc,
+						   frame);
+	struct tbv_path *path = desc->path;
+	struct tbv_zc_rx_stream *stream = desc->stream;
+	struct tbv_state *state = tbv_path_state(path);
+	struct tbv_data_frame *bounce = desc->bounce;
+	struct tbv_native_data_header hdr;
+	u32 len = tbv_frame_len(frame);
+	LIST_HEAD(retired);
+	unsigned long flags;
+	bool deliver = false;
+
+	if (!canceled && bounce)
+		dma_sync_single_for_cpu(tb_ring_dma_device(ring), bounce->dma,
+					TBV_DATA_FRAME_SIZE, DMA_FROM_DEVICE);
+
+	spin_lock_irqsave(&path->zc_lock, flags);
+	if (stream) {
+		if (stream->outstanding)
+			stream->outstanding--;
+		if (canceled) {
+			stream->error = true;
+		} else if (!stream->error) {
+			struct tbv_native_data_header stream_hdr = stream->hdr;
+
+			stream_hdr.length = stream->total;
+			if (len != desc->expect_len ||
+			    tbv_native_data_raw_payload_header(
+				    &stream_hdr, stream->done,
+				    stream->total - stream->done, len, &hdr)) {
+				stream->error = true;
+				atomic64_inc(&path->zc_rx_bad_frame);
+			} else {
+				stream->done += len;
+				deliver = true;
+			}
+		}
+	}
+	spin_unlock_irqrestore(&path->zc_lock, flags);
+
+	if (deliver && state && path->rail) {
+		if (bounce)
+			atomic64_inc(&path->zc_rx_bounced);
+		else
+			atomic64_inc(&path->zc_rx_placed);
+		/*
+		 * Deliver against the MAIN path: acks and any responses must
+		 * never ride the payload-only zc path. payload == NULL means
+		 * "already placed in the destination MR" — the write handler
+		 * only advances its bookkeeping.
+		 */
+		tbv_ibdev_rx_native_frame(state, &path->rail->path, &hdr,
+					  bounce ? bounce->buf : NULL);
+	}
+
+	spin_lock_irqsave(&path->zc_lock, flags);
+	desc->stream = NULL;
+	desc->bounce = NULL;
+	if (bounce)
+		list_add_tail(&bounce->free_node, &path->zc_free_bounce);
+	list_add_tail(&desc->node, &path->zc_free_descs);
+	while (!list_empty(&path->zc_streams)) {
+		struct tbv_zc_rx_stream *head =
+			list_first_entry(&path->zc_streams,
+					 struct tbv_zc_rx_stream, node);
+
+		if (head->posted != head->total || head->outstanding)
+			break;
+		list_move_tail(&head->node, &retired);
+	}
+	spin_unlock_irqrestore(&path->zc_lock, flags);
+
+	while (!list_empty(&retired)) {
+		struct tbv_zc_rx_stream *head =
+			list_first_entry(&retired, struct tbv_zc_rx_stream,
+					 node);
+
+		list_del_init(&head->node);
+		if (head->error)
+			atomic64_inc(&path->zc_rx_stream_errors);
+		tbv_ibdev_zc_stream_end(head->mr_handle);
+		kfree(head);
+	}
+
+	if (!canceled)
+		tbv_path_zc_post_more(path);
+}
+
+void tbv_path_zc_rx_arm(struct tbv_state *state, struct tbv_rail *rail,
+			const struct tbv_native_data_header *hdr)
+{
+	struct tbv_path *path = &rail->zc_path;
+	struct tbv_zc_rx_stream *stream;
+	unsigned long flags;
+
+	if (!path->zc_rx || path->state != TBV_PATH_TUNNEL_ENABLED ||
+	    !hdr->frag_offset || hdr->frag_offset > TBV_DATA_FRAME_SIZE ||
+	    hdr->frag_offset > hdr->length) {
+		if (state)
+			atomic64_inc(&state->data_rx_bad_frame);
+		return;
+	}
+
+	stream = kzalloc(sizeof(*stream), GFP_ATOMIC);
+	if (!stream) {
+		if (state)
+			atomic64_inc(&state->data_rx_bad_frame);
+		return;
+	}
+	INIT_LIST_HEAD(&stream->node);
+	stream->hdr = *hdr;
+	stream->total = hdr->length;
+	stream->first_chunk = hdr->frag_offset;
+	stream->mr_handle = tbv_ibdev_zc_stream_begin(state, hdr);
+
+	spin_lock_irqsave(&path->zc_lock, flags);
+	list_add_tail(&stream->node, &path->zc_streams);
+	spin_unlock_irqrestore(&path->zc_lock, flags);
+	atomic64_inc(&path->zc_rx_streams);
+	tbv_path_zc_post_more(path);
+}
+
+void tbv_path_zc_flush(struct tbv_path *path)
+{
+	LIST_HEAD(flush);
+	struct tbv_zc_rx_stream *stream;
+	struct tbv_zc_rx_stream *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&path->zc_lock, flags);
+	list_for_each_entry_safe(stream, tmp, &path->zc_streams, node) {
+		/*
+		 * Streams with outstanding descriptors would be use-after-free
+		 * targets for late canceled completions; by the time flush
+		 * runs (rings stopped and freed) there should be none — leak
+		 * loudly rather than corrupt if that assumption ever breaks.
+		 */
+		if (stream->outstanding) {
+			pr_warn("zc flush leaking stream with %u outstanding descs\n",
+				stream->outstanding);
+			list_del_init(&stream->node);
+			continue;
+		}
+		list_move_tail(&stream->node, &flush);
+	}
+	path->zc_credit_pending = 0;
+	spin_unlock_irqrestore(&path->zc_lock, flags);
+
+	while (!list_empty(&flush)) {
+		stream = list_first_entry(&flush, struct tbv_zc_rx_stream,
+					  node);
+		list_del_init(&stream->node);
+		tbv_ibdev_zc_stream_end(stream->mr_handle);
+		kfree(stream);
+	}
+}
